<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Acorn.Wasm</RootNamespace>
    <AssemblyName>Acorn.Wasm</AssemblyName>
    <Version>0.0.0</Version>
    <Authors>nyar-vm</Authors>
    <Description>Acorn WebAssembly 解码器，提供 Wasm 二进制格式解析功能</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Acorn\Acorn.csproj" />
    <ProjectReference Include="..\Generator.Acorn\Generator.Acorn.csproj" ReferenceOutputAssembly="false" OutputItemType="Analyzer" />
  </ItemGroup>

</Project>
